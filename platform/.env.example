# Copy to .env (never commit .env) or set these in your host's environment settings.
PORT=8080
DB_PATH=./data/fastrobox.db
# Seconds of silence before a device is marked offline (paper: within 30 s).
OFFLINE_AFTER_S=20
# Device tokens, one per device: DEVICE_ID:TOKEN, comma separated. Choose long random values.
DEVICE_TOKENS=T01-D1:replace-with-a-long-random-token
# Token for reading records (GET /api/*, /records). Level 4 replaces this with real logins.
ADMIN_TOKEN=replace-with-another-long-random-token
# Optional: run HTTPS directly. Leave empty when your host already provides HTTPS.
TLS_KEY_FILE=
TLS_CERT_FILE=
