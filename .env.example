# Dev-only mock device credential (test credential, NOT a real device token).
# The in-memory dev device is seeded with the sha256 hash of this value.
# Prompt 02 replaces the in-memory store with Supabase; real tokens are generated per device and only hashed verifiers are stored.
DEV_DEVICE_ID=T07-D1
DEV_DEVICE_ROOM=ROOM-101
DEV_DEVICE_TOKEN=dev-device-token-T07-D1

# Base URL the mock simulator targets.
MOCK_BASE_URL=http://localhost:3000

# Supabase (Prompt 03). Public values reach the browser; service-role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Server/worker only. NEVER expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Face inference service (Prompt 07). Unset => enrolment/check-in fail closed (never grants).
INFERENCE_URL=
INFERENCE_TOKEN=
# Dev only: synthetic face results so the flow can be exercised without a model. Ignored in production.
MOCK_INFERENCE=

# Phone alerts (Prompt 08). One real channel: Telegram. Unset => deliveries are recorded as FAILED (channel_not_configured).
TELEGRAM_BOT_TOKEN=

# Weather (Prompt 09). Open-Meteo needs no key; an optional paid key stays server-side.
OPEN_METEO_API_KEY=

# Live view (Prompt 10): an external stream worker serves the video; this site only mints a 60 s signed link.
STREAM_WORKER_URL=
STREAM_SIGNING_SECRET=

# Model evaluation ingest (Prompts 10/11): the training script posts its REAL held-out results here.
MODEL_INGEST_TOKEN=

# Evidence file names (Prompt 12): <TEAM_ID>_L<NN>_video.mp4. Falls back to the first device's team code.
TEAM_ID=

# Dev only: set MOCK_VISION=1 when running the mock simulator to send synthetic camera/CSI/link samples.
MOCK_VISION=

# Secret for the periodic worker POST /api/jobs/sweep (absent marking + storage cleanup).
CRON_SECRET=

# Direct Postgres connection for device ingestion (Prompt 04). Supabase connection string.
# Server-only. The device API uses raw SQL functions, not PostgREST.
DATABASE_URL=
